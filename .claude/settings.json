{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Read(./spych/**)",
      "Edit(./spych/**)",
      "Read(./scripts/**)",
      "Edit(./scripts/**)",
      "Read(./README.md)",
      "Edit(./README.md)",
      "Read(./AGENTS.md)",
      "Edit(./AGENTS.md)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run nox)",
      "Bash(uv run nox *)",
      "Bash(./run.sh prettify)",
      "Bash(./run.sh test)"
    ],
    "deny": [
      "Read(**/__pycache__/**)",
      "Read(**/venv/**)",
      "Bash(./run.sh **)"
    ]
  }
}